# Copy to .env. Never commit the real file — .gitignore covers *.env.

# ---------------------------
# Database
# ---------------------------
# Either DATABASE_URL, or the SUPABASE_DB_* set below.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=

# ---------------------------
# Supabase
# ---------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (publishable) key — used only to exchange a password for a session.
SUPABASE_ANON_KEY=

# Service-role key. Full admin over your auth users: server-side only, never
# ship it to the browser. Required for SMS login, which creates users and mints
# sessions on their behalf.
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist fallback when a user has no role="admin" claim.
# ADMIN_USER_IDS=

# ---------------------------
# SMS login
# ---------------------------
# Which provider drives the OTP. See SMS_LOGIN.md for why this is a
# provider-validated code rather than Supabase's own phone OTP.
SMS_OTP_PROVIDER=verifynow

# Message Central VerifyNow credentials (console -> API keys).
# VERIFYNOW_KEY is the base-64 encoded password, not the plaintext one.
VERIFYNOW_CUSTOMER_ID=
VERIFYNOW_KEY=
VERIFYNOW_EMAIL=
# VERIFYNOW_BASE_URL=https://cpaas.messagecentral.com

# Abuse limits. Every send costs money, so keep these tight.
# SMS_OTP_LENGTH=6
# SMS_OTP_TTL_SECONDS=300
# SMS_OTP_RESEND_SECONDS=60
# SMS_OTP_MAX_ATTEMPTS=5
# SMS_OTP_MAX_PER_PHONE_PER_HOUR=5
# SMS_OTP_MAX_PER_IP_PER_HOUR=20

# Country handling for bare national numbers. "1" = US/Canada.
# SMS_DEFAULT_COUNTRY_CODE=1
# SMS_COUNTRY_CODES=1,44,61,91

# ---------------------------
# Metrc API (proficiency evaluation + integration)
# ---------------------------
# State code drives the host: sandbox-api-<state>.metrc.com.
METRC_STATE=ny
METRC_SANDBOX=true

# Integrator ("vendor") key from Metrc Connect. Identifies your software.
METRC_VENDOR_KEY=

# Industry user key. Carries ALL the permissions — the vendor key alone
# authenticates nothing except POST /sandbox/v2/integrator/setup.
# Mint one with: python -m scripts.metrc.run setup-user
METRC_USER_KEY=

# Facility to evaluate against. Find it with: python -m scripts.metrc.run facilities
METRC_LICENSE_NUMBER=

# Where call transcripts are written.
METRC_RUN_DIR=evidence/metrc
