# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python environments
.venv/
venv/
env/

# Node
node_modules/
ui/my-app/.vite/

# Scraped output — generated artifacts, not source
data/scrapes/
prototypes/**/*_listings.csv
travel_agency_listings.csv
*.usage.json

# Enrich cache — large, machine-local, regeneratable
data/enrich_cache/

# Catalog exports — Postgres is the system of record (PIPELINE.md, "Brand
# catalogs"); catalog_bootstrap.py and storefront.py rewrite these on every run.
data/catalogs/*.json
!data/catalogs/ayrloom.json

# Editor / OS
.vscode/
.DS_Store

# Secrets
*.env

# Claude Code: personal overrides stay local; shared settings, hooks and
# commands are versioned so every session gets the same permission rules.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
