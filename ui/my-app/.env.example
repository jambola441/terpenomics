# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SMS login: country code assumed when a user types a bare national number.
# "1" = US/Canada. Users can always type a full +<country><number> instead.
VITE_DEFAULT_COUNTRY_CODE=1

# ── Portal map basemap ───────────────────────────────────────────────────────
# CARTO stamps "API KEY REQUIRED" across every tile when called anonymously, so
# the map needs a keyed provider. Set the key plus one of the presets in
# src/utils/mapTiles.ts: thunderforest | maptiler | stadia | carto.
# Without a key the map falls back to plain OpenStreetMap tiles.
VITE_MAP_PROVIDER=thunderforest
# VITE_MAP_TILE_KEY=your_tile_provider_api_key_here
# VITE_MAP_STYLE=transport-dark

# Or point the map at any other raster provider directly:
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}{r}.png?key=...
# VITE_MAP_TILE_ATTRIBUTION=© Example
# VITE_MAP_TILE_FILTER=none
# VITE_MAP_TILE_RETINA=true
