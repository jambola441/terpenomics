# Copy to .env.local. EXPO_PUBLIC_* values are inlined into the app bundle, so
# only put public values here: the publishable Supabase key, never a service key.
EXPO_PUBLIC_API_BASE_URL=https://your-api.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
