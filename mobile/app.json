{
  "expo": {
    "name": "Terpenomics",
    "slug": "terpenomics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terpenomics.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.terpenomics.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Terpenomics checks that you are in New York, where reserving cannabis for pickup is legal, before placing an order."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Terpenomics uses your photos so you can upload a receipt from a partner store and get your Terpee points.",
          "cameraPermission": "Terpenomics uses the camera so you can photograph a receipt from a partner store and get your Terpee points.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "terpenomics",
    "experiments": {
      "typedRoutes": true
    }
  }
}
